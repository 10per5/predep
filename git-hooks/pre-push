#!/usr/bin/env bash
#
# pre-push hook: enforce that every commit pushed to `main` follows the
# required subject format:  build(<scope>): <message>
#
# Commits with any other prefix (e.g. "feat:", "fix:", "WIP") are rejected
# before they ever reach the remote. Pushes to other branches are not checked.
#
# Installed via `scripts/setup-hooks.sh` (sets core.hooksPath to git-hooks/).

set -euo pipefail

MAIN_REF="refs/heads/main"
PATTERN='^build\([^()]*\): .+'
ZERO="0000000000000000000000000000000000000000"

reject=0

while read -r local_ref local_oid remote_ref remote_oid; do
    # Only enforce pushes that land on main.
    [ "$remote_ref" = "$MAIN_REF" ] || continue

    # Range of commits being introduced on main.
    if [ "$remote_oid" = "$ZERO" ]; then
        # New branch pushed — check everything reachable from the tip.
        range="$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi

    while IFS= read -r commit; do
        [ -z "$commit" ] && continue
        subject="$(git log -1 --format=%s "$commit")"
        if ! printf '%s' "$subject" | grep -Eq "$PATTERN"; then
            echo "  rejected commit $commit" >&2
            echo "    subject: $subject" >&2
            echo "    expected: build(<scope>): <message>" >&2
            reject=1
        fi
    done < <(git rev-list "$range")
done

if [ "$reject" -ne 0 ]; then
    echo "pre-push: push to 'main' rejected — every commit must follow 'build(<scope>): <message>'." >&2
    exit 1
fi
